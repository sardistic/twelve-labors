# Browser-visible Discord app id. Set this in Railway and local .env.
VITE_DISCORD_CLIENT_ID=

# Server-only Discord OAuth secret. Never expose this in frontend code.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Server-only Discord bot pieces for slash commands, signed interactions, and reminders.
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

# Optional. Use for instant command updates in one test server; omit for global commands.
DISCORD_GUILD_ID=

# Must match a Redirect URL in the Discord Developer Portal.
# Local: https://127.0.0.1:5178/ is not valid unless you serve HTTPS locally.
# Dev default: http://127.0.0.1:5178/
# Railway example: https://gym-playbook-production.up.railway.app/
DISCORD_REDIRECT_URI=

# Random long secret used to sign app session tokens.
SESSION_SECRET=

# Optional. On Railway, point this at a mounted volume for durable file storage.
DATA_DIR=./data
